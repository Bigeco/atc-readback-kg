  "lexical_cues": {
    "TAXI_VIA": "\\b(taxi|via|join|continue|ramp|down|on|to)\\b|\\b(alpha|bravo|charlie|delta|echo|fox\\w*|golf|hotel|juliet\\w*|kilo|lima|mike|november|papa|romeo|sierra|tango|uniform|victor|whiskey|yankee|zulu)\\b",
    "HOLD_SHORT": "hold\\s+short|hold\\s+for|short\\s+of",
    "CROSS_RUNWAY": "\\bcross",
    "HOLD_POSITION": "hold\\s+(your\\s+)?position",
    "GIVE_WAY": "give\\s+way|get\\s+away|gave\\s+way|give\\s+away",
    "FOLLOW": "follow|behind",
    "CONTACT": "contact",
    "MONITOR": "monitor",
    "LINE_UP_AND_WAIT": "line\\s+up",
    "CLEARED_FOR_TAKEOFF": "take\\s?off",
    "CLEARED_TO_LAND": "clear\\w*\\s+to\\s+land",
    "TURN": "\\bturn|\\bleft\\b|\\bright\\b",
    "CLIMB": "\\bclimb",
    "DESCEND": "\\bdescend",
    "HEADING": "\\bheading\\b|\\bfly\\s+\\d",
    "SQUAWK": "squawk",
    "TRAFFIC_INFO": "traffic|o'?clock|from\\s+your|company",
    "WAKE_ADVISORY": "wake|heavy\\s+departed|caution"
  },
  "_lexical_cues_note": "An extracted concept is kept only if its cue matches the transcript (guards against LLM hallucination, C13)."
}